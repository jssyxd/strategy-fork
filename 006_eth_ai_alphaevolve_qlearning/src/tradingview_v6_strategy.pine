//@version=6
strategy("006 ETH AI AlphaEvolve Q-Learning 策略 (官方OKX治理数据重训版)", 
         overlay=true, 
         initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=50, 
         commission_type=strategy.commission.percent, 
         commission_value=0.05,
         pyramiding=2)

// ==========================================
// 1. 20,000代真实演化收敛超参数 (Kaggle/本地 Checkpoint)
// ==========================================
var string GRP_EVO  = "AlphaEvolve 遗传状态机参数"
var string GRP_RISK = "风控与动态离场机制"

gamma          = input.float(0.938, "Q-Learning 状态折现率 (Decay)", minval=0.5, maxval=0.99, group=GRP_EVO)
w_imb          = input.float(1.585, "订单流买卖微观失衡权重 (Imbalance Weight)", group=GRP_EVO)
w_bo           = input.float(1.346, "通道突破强度权重 (Breakout Weight)", group=GRP_EVO)
w_dev          = input.float(0.303, "均线偏离度权重 (Deviation Weight)", group=GRP_EVO)
th_50          = input.float(0.842, "50% 保证金试探建仓阈值", group=GRP_EVO)
th_75          = input.float(1.651, "75% 保证金重仓进场阈值", group=GRP_EVO)

atr_len        = input.int(14, "ATR 波动率周期", group=GRP_RISK)
trail_atr_mult = input.float(1.831, "动态追踪止盈 ATR 偏离", group=GRP_RISK)
sl_atr_mult    = input.float(2.774, "硬性止损 ATR 倍数", group=GRP_RISK)
tp_atr_mult    = input.float(1.770, "目标止盈 ATR 倍数", group=GRP_RISK)

// ==========================================
// 2. 特征工程与伪 Q-Learning 状态机
// ==========================================
atr_val = ta.atr(atr_len)

// 特征 1：订单流实体与影线振幅失衡代理
hl_span = high - low
body_delta = close - open
f_imbalance = hl_span > 0 ? (body_delta / hl_span) : 0.0

// 特征 2：16 周期极值通道突破位置
hh16 = ta.highest(high, 16)
ll16 = ta.lowest(low, 16)
f_breakout = (hh16 - ll16) > 0 ? ((close - ll16) / (hh16 - ll16) - 0.5) : 0.0

// 特征 3：20 周期均线偏离度
ma20 = ta.sma(close, 20)
f_dev = (close - ma20) / (atr_val + 1e-6)

// 伪 Q-Learning 状态递归更新：S_t = gamma * S_{t-1} + (1 - gamma) * Reward_t
var float state_value = 0.0
reward_signal = (w_imb * f_imbalance) + (w_bo * f_breakout) + (w_dev * f_dev)
state_value := (gamma * nz(state_value[1])) + ((1.0 - gamma) * reward_signal)

// ==========================================
// 3. 严格 Anti-Lookahead 执行 (次根 Bar 开盘入场)
// ==========================================
long_condition_50  = ta.crossover(state_value, th_50) and state_value <= th_75
long_condition_75  = ta.crossover(state_value, th_75)

short_condition_50 = ta.crossunder(state_value, -th_50) and state_value >= -th_75
short_condition_75 = ta.crossunder(state_value, -th_75)

var float entry_price = na
var float peak_price = na

// 多头开仓
if strategy.position_size == 0
    if long_condition_75
        strategy.entry("Long_75", strategy.long, qty=strategy.equity * 0.75 / close)
        entry_price := close
        peak_price := high
    else if long_condition_50
        strategy.entry("Long_50", strategy.long, qty=strategy.equity * 0.50 / close)
        entry_price := close
        peak_price := high
    else if short_condition_75
        strategy.entry("Short_75", strategy.short, qty=strategy.equity * 0.75 / close)
        entry_price := close
        peak_price := low
    else if short_condition_50
        strategy.entry("Short_50", strategy.short, qty=strategy.equity * 0.50 / close)
        entry_price := close
        peak_price := low

// 多头持仓动态追踪与止损
if strategy.position_size > 0
    peak_price := math.max(nz(peak_price), high)
    stop_trail = peak_price - (trail_atr_mult * atr_val)
    stop_hard  = entry_price - (sl_atr_mult * atr_val)
    target_tp  = entry_price + (tp_atr_mult * atr_val)
    exit_target = math.max(stop_trail, stop_hard)
    
    strategy.exit("Exit_Long_TP", from_entry="Long_75", limit=target_tp, stop=exit_target)
    strategy.exit("Exit_Long_50_TP", from_entry="Long_50", limit=target_tp, stop=exit_target)

// 空头持仓动态追踪与止损
if strategy.position_size < 0
    peak_price := math.min(nz(peak_price), low)
    stop_trail = peak_price + (trail_atr_mult * atr_val)
    stop_hard  = entry_price + (sl_atr_mult * atr_val)
    target_tp  = entry_price - (tp_atr_mult * atr_val)
    exit_target = math.min(stop_trail, stop_hard)
    
    strategy.exit("Exit_Short_TP", from_entry="Short_75", limit=target_tp, stop=exit_target)
    strategy.exit("Exit_Short_50_TP", from_entry="Short_50", limit=target_tp, stop=exit_target)
